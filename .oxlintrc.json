{
  "categories": {
    "correctness": "error"
  },
  "overrides": [
    {
      "files": ["apps/web/**/*.{js,ts,vue}"],
      "plugins": ["typescript", "unicorn", "oxc", "vue"],
      "env": {
        "browser": true,
        "builtin": true
      }
    },
    {
      "files": ["apps/server/**/*.{js,ts}", "packages/**/*.{js,ts}"],
      "plugins": ["typescript", "unicorn", "oxc"],
      "env": {
        "builtin": true
      },
      "rules": {
        "no-unused-vars": [
          "error",
          {
            "argsIgnorePattern": "^_",
            "varsIgnorePattern": "^_"
          }
        ]
      }
    }
  ],
  "plugins": ["typescript", "unicorn", "oxc"],
  "ignorePatterns": ["**/dist/**", "**/dist-ssr/**", "**/node_modules/**"]
}
