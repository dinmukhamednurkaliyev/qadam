{
  "name": "@qadam/server",
  "private": true,
  "type": "module",
  "scripts": {
    "development": "bun run --hot source/main.ts",
    "start": "bun source/main.ts",
    "build": "bun build source/main.ts --outdir dist --target bun --sourcemap=external",
    "start:production": "bun dist/main.js",
    "type-check": "tsc --noEmit",
    "database:generate": "drizzle-kit generate",
    "database:migrate": "drizzle-kit migrate",
    "database:push": "drizzle-kit push",
    "database:seed": "bun source/database/seeds/database-seed.ts",
    "database:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@qadam/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.8",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "drizzle-kit": "^0.31.10",
    "typescript": "catalog:"
  }
}
