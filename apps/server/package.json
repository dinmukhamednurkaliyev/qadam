{
  "name": "@qadam/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot source/app/app.ts",
    "start": "bun source/app/app.ts",
    "build": "bun build source/app/app.ts --outdir dist --target bun --sourcemap=external",
    "start:production": "bun dist/app.js",
    "type-check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "bun source/database/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@qadam/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10",
    "typescript": "catalog:"
  }
}
