{
  "name": "@qadam/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot source/main.ts",
    "start": "bun source/main.ts",
    "build": "bun build source/main.ts --outdir dist --target bun --sourcemap=external",
    "start:production": "bun dist/main.js",
    "type-check": "tsc --noEmit",
    "test": "bun test --pass-with-no-tests",
    "test:watch": "bun test --watch",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "bun source/database/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10",
    "typescript": "catalog:"
  }
}
