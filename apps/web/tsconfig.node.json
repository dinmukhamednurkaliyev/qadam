{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": ["vite.config.*", "stylelint.config.ts"],
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,

    "types": ["node"],

    "noEmit": true,

    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  }
}
