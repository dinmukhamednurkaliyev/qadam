{
  "categories": {
    "correctness": "error"
  },
  "overrides": [
    {
      "files": ["**/*.{js,ts,vue}"],
      "excludeFiles": ["vite.config.*", "stylelint.config.ts"],
      "plugins": ["typescript", "unicorn", "oxc", "vue"],
      "env": {
        "browser": true,
        "builtin": true
      }
    }
  ],
  "plugins": ["typescript", "unicorn", "oxc"],
  "ignorePatterns": ["**/dist/**", "**/dist-ssr/**", "**/node_modules/**"]
}
