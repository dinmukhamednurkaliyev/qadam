{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "source/**/*", "source/**/*.vue", "source/main.ts"],
  "exclude": ["source/**/__tests__/*"],
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,

    "paths": {
      "@/*": ["./source/*"]
    },

    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  }
}
