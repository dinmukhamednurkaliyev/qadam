{
  "name": "@qadam/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "development": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "style-check": "stylelint \"**/*.{css,vue}\" --allow-empty-input --config stylelint.config.ts",
    "style-check:fix": "bun run style-check --fix",
    "format": "prettier ../.. --config .prettierrc.json --ignore-path ../../.gitignore --ignore-path .prettierignore --write",
    "format:check": "prettier ../.. --config .prettierrc.json --ignore-path ../../.gitignore --ignore-path .prettierignore --check",
    "validate": "bun run type-check && bun run lint && bun run style-check && bun run format:check",
    "security:check": "bun audit --prod"
  },
  "dependencies": {
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.14",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "oxlint": "^1.88.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
