{
  "name": "qadam",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.4.2",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "typescript": "~6.0.3"
    }
  },
  "scripts": {
    "development": "bun run --workspaces --parallel --if-present development",
    "development:server": "bun run --filter @qadam/server development",
    "development:web": "bun run --filter @qadam/web development",
    "build": "bun run --workspaces --if-present build",
    "start": "bun run --filter @qadam/server start",
    "start:production": "bun run --filter @qadam/server start:production",
    "preview": "bun run --filter @qadam/web preview",
    "type-check": "bun run --workspaces type-check",
    "lint": "oxlint apps packages",
    "lint:fix": "oxlint apps packages --fix",
    "style-check": "stylelint \"{apps,packages}/**/*.{css,vue}\" --allow-empty-input --config stylelint.config.ts",
    "style-check:fix": "bun run style-check --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "database:generate": "bun run --filter @qadam/server database:generate",
    "database:migrate": "bun run --filter @qadam/server database:migrate",
    "database:push": "bun run --filter @qadam/server database:push",
    "database:seed": "bun run --filter @qadam/server database:seed",
    "database:studio": "bun run --filter @qadam/server database:studio",
    "quality-check": "bun run type-check && bun run lint && bun run style-check && bun run format:check"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "jiti": "2.7.0",
    "oxlint": "^1.83.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.8",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~6.0.3",
    "@types/bun": "latest"
  }
}
